# Local error handler: keeps the original HTTP status and works without MySQL.
ErrorDocument 400 "/CWT%20Site/error.php"
ErrorDocument 401 "/CWT%20Site/error.php"
ErrorDocument 403 "/CWT%20Site/error.php"
ErrorDocument 404 "/CWT%20Site/error.php"
ErrorDocument 405 "/CWT%20Site/error.php"
ErrorDocument 408 "/CWT%20Site/error.php"
ErrorDocument 410 "/CWT%20Site/error.php"
ErrorDocument 413 "/CWT%20Site/error.php"
ErrorDocument 414 "/CWT%20Site/error.php"
ErrorDocument 415 "/CWT%20Site/error.php"
ErrorDocument 422 "/CWT%20Site/error.php"
ErrorDocument 429 "/CWT%20Site/error.php"
ErrorDocument 500 "/CWT%20Site/error.php"
ErrorDocument 501 "/CWT%20Site/error.php"
ErrorDocument 502 "/CWT%20Site/error.php"
ErrorDocument 503 "/CWT%20Site/error.php"
ErrorDocument 504 "/CWT%20Site/error.php"
